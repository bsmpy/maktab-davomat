# ============================================================================
# docker compose variables. Copy to .env next to docker-compose.yml.
# Per-service secrets live in backend/.env and tgbot/.env.
# ============================================================================
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=

# Baked into the frontend bundle at build time. Leave empty: nginx serves the
# SPA and the API on one origin, so the SPA calls /api/v1 on the address it was
# opened from (e.g. http://192.168.0.100).
VITE_API_URL=
VITE_APP_NAME=Maktab davomat

# Host port nginx listens on (put a TLS-terminating proxy in front in production).
HTTP_PORT=80
