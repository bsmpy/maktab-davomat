# ============================================================================
# Backend environment. Copy to .env and fill in real values.
# NEVER commit a filled-in .env.
# ============================================================================

# --- Django ---------------------------------------------------------------
# python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.100
LOG_LEVEL=INFO

# Public URLs (used for Telegram deep links and e-mail/SMS copy). Behind the
# single-origin nginx (deploy/nginx) the SPA and the API share one address.
FRONTEND_URL=http://192.168.0.100
BACKEND_URL=http://192.168.0.100

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://attendance:CHANGE_ME@127.0.0.1:5432/attendance
DATABASE_CONN_MAX_AGE=60

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CACHE_KEY_PREFIX=attendance

# --- CORS / CSRF ----------------------------------------------------------
# Comma separated, explicit origins. Never use "*" in production.
CORS_ALLOWED_ORIGINS=http://192.168.0.100
CSRF_TRUSTED_ORIGINS=http://192.168.0.100

# --- JWT / auth cookies ---------------------------------------------------
# Leave JWT_SIGNING_KEY empty to reuse DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/v1/auth/
# Leave empty: the SPA and the API share one origin, so the cookie needs no domain.
AUTH_COOKIE_DOMAIN=
# True only when served over HTTPS — over plain http:// the browser drops a Secure cookie.
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# --- Sensitive field protection ------------------------------------------
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# python -c "import secrets;print(secrets.token_urlsafe(48))"  (rotating it invalidates JSHSHIR lookups)
JSHSHIR_HASH_KEY=

# --- OTP ------------------------------------------------------------------
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# DEV ONLY. Must stay False in production (prod settings assert on it).
OTP_EXPOSE_IN_RESPONSE=False

# --- SMS gateway ----------------------------------------------------------
# console = print to stdout (dev)   eskiz = Eskiz.uz   http = generic JSON   dummy = tests
# Credentials can also be entered in the UI: Sozlamalar -> Integratsiyalar -> SMS,
# which overrides these values.
SMS_PROVIDER=console
SMS_API_URL=https://notify.eskiz.uz/api
SMS_API_TOKEN=
SMS_SENDER=4546
SMS_TIMEOUT=10

# --- Rate limits (DRF throttle rates) ------------------------------------
THROTTLE_OTP_REQUEST=5/hour
THROTTLE_OTP_VERIFY=10/hour
THROTTLE_LOGIN=10/hour
THROTTLE_REGISTRATION=20/hour
THROTTLE_STUDENT_SEARCH=30/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_USER=1000/hour

# --- Registration ---------------------------------------------------------
REGISTRATION_SESSION_TTL_SECONDS=1800
STUDENT_SEARCH_MIN_QUERY=3
STUDENT_SEARCH_MAX_RESULTS=8
REGISTRATION_IDENTIFY_MAX_ATTEMPTS=5

# --- Attendance -----------------------------------------------------------
# Measured at the gate. The school day and the late-arrival grace period live in
# Sozlamalar -> Integratsiyalar -> Terminallar, not here.

# --- Access terminals (Hikvision ISAPI) ----------------------------------
# Devices are configured in the UI: Sozlamalar -> Integratsiyalar -> Terminallar.
# Their ISAPI passwords are stored encrypted with FIELD_ENCRYPTION_KEY, never here.
# Nothing to set in this file.

# --- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Shared secret between the aiogram process and this API. Generate a long random string.
BOT_SERVICE_TOKEN=
TELEGRAM_LINK_TOKEN_TTL_SECONDS=900
TELEGRAM_API_TIMEOUT=10

# --- Production only ------------------------------------------------------
# Keep False over plain http:// (there is no HTTPS to redirect to), or when a
# reverse proxy in front already redirects — otherwise requests loop.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# Demo clock: seconds added to every time the application reads, so the cabinet
# can be shown on a weekday that has not arrived yet. 0 = real time.
CLOCK_OFFSET_SECONDS=0
