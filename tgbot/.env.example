# ============================================================================
# Telegram bot environment. Copy to .env and fill in real values.
# The bot NEVER talks to PostgreSQL directly — everything goes through the API.
# ============================================================================

# From @BotFather
BOT_TOKEN=
# Without the leading @ — used to build deep links
BOT_USERNAME=

# Django REST API root (no trailing slash)
BACKEND_API_URL=http://127.0.0.1:8000
# Shared secret; must match BOT_SERVICE_TOKEN in the backend .env
BOT_SERVICE_TOKEN=

# Web cabinet, linked from the bot
FRONTEND_URL=http://192.168.0.100

# FSM storage. Leave empty to use in-memory storage (single instance only).
REDIS_URL=redis://127.0.0.1:6379/6

HTTP_TIMEOUT=15
LOG_LEVEL=INFO
