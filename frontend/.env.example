# Frontend environment. Copy to .env (or .env.local) and adjust.
# Base URL of the Django API — no trailing slash. Leave empty for a production
# build served behind nginx on the same origin (the SPA then calls /api/v1).
VITE_API_URL=http://127.0.0.1:8000
# Shown on the login screen / page title.
VITE_APP_NAME=Maktab davomat
# Telegram bot username, without the leading @.
VITE_BOT_USERNAME=
